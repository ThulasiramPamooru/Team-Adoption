# ─────────────────────────────────────────────
# FlowGuard — Environment Variables Template
# Copy to .env and fill in your values
# ─────────────────────────────────────────────

# Auth0
AUTH0_DOMAIN=your-domain.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
AUTH0_AUDIENCE=https://flowguard-api
VITE_AUTH0_DOMAIN=your-domain.auth0.com
VITE_AUTH0_CLIENT_ID=your-auth0-client-id
VITE_AUTH0_AUDIENCE=https://flowguard-api

# Database (Render PostgreSQL or local)
DATABASE_URL=postgresql+asyncpg://flowguard:flowguard@localhost:5432/flowguard
DATABASE_URL_SYNC=postgresql://flowguard:flowguard@localhost:5432/flowguard

# GitHub Integration
GITHUB_TOKEN=ghp_your_personal_access_token
GITHUB_ORG=ThulasiramPamooru
GITHUB_REPO=Team-Adoption

# Jira Integration
JIRA_URL=https://dolcera.atlassian.net
JIRA_EMAIL=your@email.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=DIPA

# App URLs
API_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000
WEB_URL=http://localhost:5173
VITE_WS_URL=ws://localhost:8000

# Security
SECRET_KEY=your-super-secret-key-change-in-production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Target Applications
DEFAULT_TARGET_APP=drafting-ai

# Deployment (Render / Vercel auto-populates these)
RENDER_EXTERNAL_URL=
VERCEL_URL=
